<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
    <Package Name="Siplicity"
             Version="1.0.0.0"
             Manufacturer="Richard Lehane"
             UpgradeCode="CAA4E00D-1329-445F-B4BA-F7039303D5F7">
        <MediaTemplate EmbedCab="yes" />
        <Files Include="files\**" />
        <StandardDirectory Id="ProgramMenuFolder">
            <Component Id="ApplicationShortcutStartMenu"
                       Guid="CAA4E00D-1329-445F-B4BA-F7039303D5F7">
                <Shortcut Id="ApplicationShortcutStartMenu"
                          Name="Siplicity"
                          Description="Makes transferring digital files simple"
                          Target="[INSTALLFOLDER]Siplicity.exe"
                          WorkingDirectory="INSTALLFOLDER" />
                <RemoveFolder Id="ProgramMenuFolder"
                              On="uninstall" />
                <RegistryValue Root="HKCU"
                               Key="Software\Siplicity\Siplicity"
                               Name="installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </StandardDirectory>
        <WixVariable Id="WixUILicenseRtf"
                     Value="siplicity.rtf" />
        <WixVariable Id="WixUIDialogBmp"
                     Value="siplicity.bmp" />
        <ui:WixUI Id="WixUI_Minimal" />
    </Package>
</Wix>